{
    "name": "kipchak/driver-anthropic",
    "type": "library",
    "description": "An Anthropic driver for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "Anthropic",
        "Claude",
        "AI",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\Anthropic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kipchak\\Driver\\Anthropic\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "anthropic-ai/sdk": "^0.36",
        "kipchak/core": "^2 || ^3",
        "kipchak/driver-config": "^1",
        "kipchak/driver-http": "^2.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    }
}
